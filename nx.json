{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "extends": "@omnifield/nx-preset/nx.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/vitest.setup.ts"
    ],
    "sharedGlobals": ["{workspaceRoot}/biome.json", "{workspaceRoot}/tsconfig.base.json"]
  },
  "sync": {
    "applyChanges": true
  }
}
