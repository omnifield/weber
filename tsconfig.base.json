{
  "compilerOptions": {
    "baseUrl": ".",
    "typeRoots": ["./node_modules/@types"],
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ESNext",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@omnifield/web-state": ["packages/web/runtime/state/src/index.ts"],
      "@omnifield/web-dnd": ["packages/web/runtime/dnd/src/index.ts"],
      "@omnifield/web-dnd/controllers": ["packages/web/runtime/dnd/src/controllers/index.ts"],
      "@omnifield/web-query": ["packages/web/runtime/query/src/index.ts"],
      "@omnifield/web-query/stream": ["packages/web/runtime/query/src/stream/index.ts"],
      "@omnifield/web-style": ["packages/web/runtime/style/src/index.ts"],
      "@omnifield/web-style/editor": ["packages/web/runtime/style/src/editor/index.ts"],
      "@omnifield/web-style/css": ["packages/web/runtime/style/src/index.css"],
      "@omnifield/web-style/themes": ["packages/web/runtime/style/src/themes/index.css"],
      "@omnifield/web-style/themes/*": ["packages/web/runtime/style/src/themes/*"],
      "@omnifield/shared-zod": ["packages/shared/zod/src/index.ts"],
      "@omnifield/shared-zod/gen": ["packages/shared/zod/src/gen/index.ts"],
      "@omnifield/shared-utils": ["packages/shared/utils/src/index.ts"]
    }
  }
}
