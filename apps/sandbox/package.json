{
  "name": "sandbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Verification-полигон build-infra: полный стек (engine+kit+registry+глобалы); vite build = e2e-гейт",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src"
  },
  "dependencies": {
    "@omnifield/weber-engine": "workspace:*",
    "@omnifield/weber-kernel": "workspace:*",
    "@omnifield/weber-logic": "workspace:*",
    "@omnifield/weber-state": "workspace:*",
    "@omnifield/weber-style": "workspace:*",
    "@omnifield/weber-ui": "workspace:*",
    "solid-js": "^1.9.12",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@omnifield/weber-vite": "workspace:*",
    "typescript": "^5.9.3",
    "vite": "^8.0.13"
  },
  "nx": {
    "tags": [
      "type:app"
    ],
    "targets": {
      "typecheck": {
        "dependsOn": [
          "^build"
        ]
      },
      "lint": {
        "dependsOn": [
          "^build"
        ]
      }
    }
  }
}
