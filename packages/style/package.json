{
  "name": "@weber/style",
  "version": "0.1.0",
  "type": "module",
  "description": "Weber styling layer — token contract, createStyle/cn, zero-config light/dark, custom palettes via config",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./css": "./dist/css/base.css",
    "./themes.css": "./dist/css/themes.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build",
    "lint": "biome check src"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@weber/lib-builder": "workspace:*",
    "jsdom": "~29.1.1",
    "solid-js": "^1.9.12",
    "vite": "^8.0.13",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "~4.1.0"
  },
  "publishConfig": {
    "access": "public",
    "packageManager": "pnpm"
  },
  "nx": {
    "tags": [
      "type:package"
    ]
  }
}
